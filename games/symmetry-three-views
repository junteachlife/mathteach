<script type="module">
const GAME_ID="symmetry-three-views";
const CHAPTER="7-2-6";
const GAME_TITLE="6 線對稱與三視圖大挑戰";
const MODES={
  "geometryBasics":{name:"簡單圖形與垂直平分",difficultyWeight:1},
  "symmetryJudge":{name:"線對稱判斷",difficultyWeight:1},
  "reflection":{name:"對稱點與完成圖形",difficultyWeight:1},
  "threeViews":{name:"三視圖",difficultyWeight:1},
  "comprehensive":{name:"第 6 章綜合挑戰",difficultyWeight:1.15}
};

const $=id=>document.getElementById(id);
const pick=a=>a[Math.floor(Math.random()*a.length)];
const rand=(a,b)=>Math.floor(Math.random()*(b-a+1))+a;
const shuffle=a=>{const b=[...a];for(let i=b.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[b[i],b[j]]=[b[j],b[i]]}return b};
const esc=s=>String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const same=(a,b)=>Number.isFinite(Number(a))&&Math.abs(Number(a)-Number(b))<1e-9;
const gcd=(a,b)=>{a=Math.abs(a);b=Math.abs(b);while(b)[a,b]=[b,a%b];return a||1};
function fracHTML(n,d=1){if(d<0){n=-n;d=-d}const g=gcd(n,d);n/=g;d/=g;if(d===1)return String(n).replace("-","−");return `<span style="display:inline-flex;flex-direction:column;vertical-align:middle;text-align:center;line-height:1.05"><span style="border-bottom:1.5px solid currentColor;padding:0 .15em">${String(n).replace("-","−")}</span><span>${d}</span></span>`}
function valueHTML(v){if(Number.isInteger(v))return String(v).replace("-","−");const sign=v<0?-1:1,x=Math.abs(v);for(let d=2;d<=20;d++){const n=Math.round(x*d);if(Math.abs(n/d-x)<1e-9)return fracHTML(sign*n,d)}return String(Math.round(v*100)/100).replace("-","−")}
function fmtSign(n){return n<0?`− ${Math.abs(n)}`:`＋ ${n}`}
function formatTime(sec){const m=Math.floor(sec/60),s=sec%60;return `${String(m).padStart(2,"0")}:${String(s).padStart(2,"0")}`}
function expObj(think,steps,answer,tip=""){return{think,steps,answer,tip}}
function qChoice(html,choices,answer,explanation,difficulty="基礎題"){return{type:"choice",html,choices,answer,explanation,difficulty}}
function qNumber(html,answer,explanation,difficulty="基礎題",answerHTML=null){return{type:"number",html,answer,explanation,difficulty,answerHTML}}
function qIneq(html,relation,value,explanation,difficulty="基礎題",answerHTML=null){return{type:"inequality",html,answer:{relation,value},explanation,difficulty,answerHTML}}
function makeQuestions(core,advanced=[]){const out=[];for(let i=0;i<8;i++)out.push(pick(core)());for(let i=0;i<2;i++)out.push(pick(advanced.length?advanced:core)());return shuffle(out)}


let singleMathInput=null;
let selectedChoice=null;
let selectedRelation=null;
let lastMathInputMessage="";

function destroyInput(){
  singleMathInput?.destroy?.();
  singleMathInput=null;
  selectedChoice=null;
  selectedRelation=null;
}
function numericInputOptions(mountId,placeholder="輸入答案"){
  return{
    mountId,placeholder,
    allowRadical:false,allowFraction:true,allowPlusMinus:false,allowPower:false,allowVariable:false,
    validationMode:"numeric-radical",showPreview:false,toolOrder:["fraction"],requireSimplifiedFraction:true,
    theme:{primary:getComputedStyle(document.documentElement).getPropertyValue("--primary").trim(),
      dark:getComputedStyle(document.documentElement).getPropertyValue("--primary-dark").trim(),
      light:getComputedStyle(document.documentElement).getPropertyValue("--primary-light").trim(),
      border:getComputedStyle(document.documentElement).getPropertyValue("--primary-border").trim()}
  };
}
function createNumericInput(mountId,placeholder){
  if(typeof window.MathExpressionInput!=="function"){lastMathInputMessage="共用答案輸入元件尚未載入。";return null}
  return new window.MathExpressionInput(numericInputOptions(mountId,placeholder));
}
function numericValue(instance){
  lastMathInputMessage="";
  if(!instance){lastMathInputMessage="答案輸入元件尚未完成載入。";return null}
  const r=instance.validate();
  if(!r?.valid){lastMathInputMessage=r?.message||"請先完成答案。";return null}
  const terms=r.terms||r.value?.terms||[];
  if(!terms.length){lastMathInputMessage="請先輸入答案。";return null}
  let v=0;
  for(const t of terms){
    const n=Number(t.numerator??0),d=Number(t.denominator??1),rad=Number(t.radicand??1);
    if(!Number.isFinite(n)||!Number.isFinite(d)||d===0||rad!==1){lastMathInputMessage="此題只需輸入整數或分數。";return null}
    v+=n/d;
  }
  return Number.isFinite(v)?v:null
}
function renderAnswer(q){
  destroyInput();
  const area=$("answer-area");
  if(q.type==="choice"){
