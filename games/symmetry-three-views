function g6Reflect(){
  const pts=[[-3,2],[-1,3],[-1,0]];
  const axis=0;
  const qx=pick([-4,-3,-2,-1]),qy=rand(-3,3),ans=-qx;
  return qChoice(`以 y 軸（x＝0）為對稱軸，點 P（${qx}，${qy}）的對稱點是哪一個？${gridReflectionSVG([[qx,qy],[qx+1,qy+1],[qx+1,qy-1]],axis)}`,
    shuffle([`（${ans}，${qy}）`,`（${qx}，${-qy}）`,`（${ans}，${-qy}）`,`（${qx}，${qy}）`]),`（${ans}，${qy}）`,
    expObj("關於 y 軸對稱時，左右距離相等，高度不變。",[
      `P 到 y 軸的水平距離是 ${Math.abs(qx)}。`,
      `對稱到另一側後 x 變成 ${ans}，y 仍是 ${qy}。`
    ],`（${ans}，${qy}）`,"對稱軸會垂直平分原點與對稱點的連線段。"));
}
function g6ThreeView(){
  const scenarios=[
    {heights:[[1,2,0],[1,1,1],[0,1,0]],front:[2,1,1],right:[1,2,1],top:[[1,1,0],[1,1,1],[0,1,0]]},
    {heights:[[1,1,1],[0,2,0],[0,1,0]],front:[1,2,1],right:[1,2,1],top:[[1,1,1],[0,1,0],[0,1,0]]},
    {heights:[[2,1,0],[1,1,1],[1,0,0]],front:[2,1,1],right:[2,1,1],top:[[1,1,0],[1,1,1],[1,0,0]]}
  ],s=pick(scenarios),ask=pick(["前視圖","右視圖","上視圖"]);
  let answer;
  if(ask==="上視圖")answer=blockViewSVG(s.top);
  else{
    const arr=ask==="前視圖"?s.front:s.right;
    const max=Math.max(...arr),grid=Array.from({length:max},(_,r)=>arr.map(h=>h>=max-r?1:0));
    answer=blockViewSVG(grid);
  }
  const opts=[answer];
  while(opts.length<4){
    const grid=Array.from({length:3},()=>Array.from({length:3},()=>Math.random()>.55?1:0));
    const h=blockViewSVG(grid);
    if(!opts.includes(h))opts.push(h);
  }
  return qChoice(`觀察正方體積木的高度配置（數字代表該格堆了幾層）：<table class="mini-table">${s.heights.map(r=>`<tr>${r.map(v=>`<td>${v||"—"}</td>`).join("")}</tr>`).join("")}</table>哪一個是它的${ask}？`,shuffle(opts),answer,
    expObj("三視圖只看指定方向能看到的外形輪廓，不是把立體斜視圖直接照抄。",[
      ask==="上視圖"?"上視圖只看每一格『有沒有積木』，高度多少不影響平面占格。":`${ask}要沿觀察方向把同一直線上的積木投影，取每一列能看到的最高高度。`,
      `依高度配置逐列投影，就得到正確圖形。`
    ],ask,"畫三視圖時先固定『前方』方向，再決定左右順序。"),"精熟題");
}
