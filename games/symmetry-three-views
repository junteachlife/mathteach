<style>
:root{--primary:#7c3aed;--primary-dark:#5b21b6;--primary-light:#f5f3ff;--primary-border:#c4b5fd;}

:root{
  --primary:#2563eb;
  --primary-dark:#1d4ed8;
  --primary-light:#eff6ff;
  --primary-border:#93c5fd;
  --ink:#172033;
  --muted:#64748b;
  --surface:#ffffff;
  --soft:#f8fafc;
  --good:#047857;
  --bad:#b91c1c;
  --warn:#b45309;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;
  color:var(--ink);
  font-family:"Noto Sans TC","Microsoft JhengHei",system-ui,sans-serif;
  background:
    linear-gradient(135deg,rgba(255,255,255,.92),rgba(250,245,235,.88)),
    repeating-linear-gradient(0deg,transparent 0 31px,rgba(15,23,42,.035) 32px),
    repeating-linear-gradient(90deg,transparent 0 31px,rgba(15,23,42,.035) 32px);
  min-height:100vh;
}
button,input{font:inherit}
.hidden{display:none!important}
.page-shell{width:min(1180px,calc(100% - 22px));margin:20px auto 60px}
.game-card{
  position:relative;
  overflow:visible;
  background:rgba(255,255,255,.97);
  border-radius:28px;
  border-top:7px solid var(--primary);
  box-shadow:0 18px 44px rgba(15,23,42,.12);
  padding:22px 24px 34px;
}
.game-card-return-row{
  position:absolute;top:12px;right:14px;z-index:30;
}
.semester-return-link{
  display:inline-flex;align-items:center;gap:6px;
  min-height:40px;padding:8px 14px;border:1.5px solid var(--primary-border);
  border-radius:12px;background:#fff;color:var(--primary-dark);
  font-weight:900;text-decoration:none;box-shadow:0 4px 0 rgba(15,23,42,.08)
}
.game-header{text-align:center;padding:62px 12px 18px}
.game-title{margin:0;color:var(--primary-dark);font-size:clamp(29px,5vw,48px);line-height:1.25}
.game-subtitle{margin:10px auto 0;max-width:860px;color:var(--muted);font-weight:700;line-height:1.7}
.concept-row{display:flex;justify-content:center;flex-wrap:wrap;gap:8px;margin-top:14px}
.concept-chip{padding:6px 10px;border:1px solid var(--primary-border);border-radius:999px;background:#fff;color:var(--primary-dark);font-size:13px;font-weight:900}
.screen{margin-top:8px}
.section-title{font-size:23px;margin:10px 0 16px}
.mode-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.mode-card{border:1.5px solid var(--primary-border);border-radius:20px;background:linear-gradient(180deg,#fff,var(--primary-light));padding:18px;display:flex;flex-direction:column;min-height:185px}
.mode-label{font-size:12px;color:var(--primary-dark);font-weight:900}
.mode-card h3{font-size:21px;margin:9px 0;color:var(--primary-dark)}
.mode-card p{color:var(--muted);line-height:1.7;margin:0 0 16px}
.mode-button{margin-top:auto;border:0;border-radius:12px;background:var(--primary);color:#fff;font-weight:900;padding:12px 16px;cursor:pointer;box-shadow:0 4px 0 var(--primary-dark)}
.quiz-top{
  display:grid;grid-template-columns:minmax(180px,.8fr) minmax(340px,1.25fr) auto;
  gap:12px;align-items:center;margin-bottom:12px;
}
.quiz-context{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.quiz-stats{display:grid;grid-template-columns:repeat(4,minmax(78px,1fr));gap:8px}
.status-box,.stat-pill{
