}
.relation-button.selected{background:var(--primary);color:#fff}
.feedback{width:min(100%,860px);margin:14px auto 0;padding:13px 16px;border-radius:13px;text-align:center;font-weight:900}
.feedback.correct{background:#ecfdf5;color:#047857;border:1px solid #86efac}
