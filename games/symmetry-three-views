    if(r?.success){
      status.innerHTML=`✅ 本次成績已儲存。${r.rank?`<br>🏆 本模式目前排名：第 ${r.rank} 名`:(r.leaderboardMessage?`<br>${esc(r.leaderboardMessage)}`:"")}`;
      status.style.color="#15803d";
    }else if(r?.reason==="not-logged-in"){status.textContent="ℹ️ 尚未登入，因此本次成績沒有儲存。";status.style.color="#b45309"}
    else{status.textContent="⚠️ 成績暫時無法儲存。";status.style.color="#b91c1c"}
  }catch(e){console.error("成績儲存失敗",e);status.textContent="⚠️ 本次遊戲已完成，但成績暫時無法儲存。";status.style.color="#b91c1c"}
}
function emitRPG(score){
  if(rpgEmitted)return;rpgEmitted=true;
  const detail={gameId:GAME_ID,modeId,chapter:CHAPTER,score,correct,wrong,total:questions.length,playTime:elapsed,accuracy:score,maxCombo,attemptId,difficultyWeight:MODES[modeId]?.difficultyWeight||1};
  window.dispatchEvent(new CustomEvent("mathgame:session-complete",{detail}));
  try{window.MathGameProgress?.completeLearningSession?.(detail)}catch(e){}
}
async function showResult(){
  stopTimer();const score=Math.round(correct/questions.length*1000)/10,[stars,comment]=rating(score);
  $("progress-bar").style.width="100%";showOnly("result-screen");$("final-score").textContent=`${Number.isInteger(score)?score:score.toFixed(1)} 分`;
  $("final-stars").textContent=stars;$("final-comment").textContent=comment;$("final-correct").textContent=correct;$("final-wrong").textContent=wrong;$("final-combo").textContent=maxCombo;$("final-time").textContent=formatTime(elapsed);
  playGameSound("playComplete");await saveScore(score);emitRPG(score);
}
function showReview(){
  $("review-list").innerHTML=records.map(r=>`<article class="review-card ${r.correct?"correct-review":"wrong-review"}">
    <div class="review-title">第 ${r.number} 題 ${r.correct?"✅":"❌"}</div>
    <div class="review-question">${r.question.html}</div>
    <div class="review-answer-line">你的答案：<strong>${r.userAnswerHTML}</strong></div>
    <div class="review-answer-line">正確答案：<strong>${answerHTML(r.question)}</strong></div>
    ${explanationHTML(r.question)}
  </article>`).join("");
  showOnly("review-screen");window.scrollTo({top:0,behavior:"smooth"});
}
document.querySelectorAll(".mode-button").forEach(b=>b.addEventListener("click",()=>startGame(b.dataset.mode)));
$("submit-button").addEventListener("click",submitAnswer);$("next-button").addEventListener("click",nextQuestion);
$("restart-button").addEventListener("click",restartCurrentModeWithConfirmation);$("quit-button").addEventListener("click",backToModesWithConfirmation);
$("again-button").addEventListener("click",restartCurrentModeWithConfirmation);$("review-button").addEventListener("click",showReview);$("result-mode-button").addEventListener("click",backToModesWithConfirmation);
$("review-again-button").addEventListener("click",restartCurrentModeWithConfirmation);$("review-result-button").addEventListener("click",()=>showOnly("result-screen"));
document.addEventListener("keydown",e=>{if(e.key!=="Enter")return;if(!$("quiz-screen").classList.contains("hidden")){if(answered)nextQuestion();else submitAnswer()}});
ensureScratchpadButton();

</script>
</body></html>
