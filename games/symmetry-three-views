function numberLineSVG(value,relation){
  const min=value-4,max=value+4,w=520,h=110,left=40,right=500,y=58;
  const x=v=>left+(v-min)/(max-min)*(right-left);
  const closed=relation==="≥"||relation==="≤",goRight=relation===">"||relation==="≥";
  const start=goRight?x(value):x(min),end=goRight?x(max):x(value);
  let ticks="";
  for(let v=min;v<=max;v++){ticks+=`<line x1="${x(v)}" y1="${y-7}" x2="${x(v)}" y2="${y+7}" stroke="#64748b" stroke-width="1.5"/><text x="${x(v)}" y="${y+28}" text-anchor="middle" font-size="14">${v}</text>`}
  return `<div class="diagram-box"><svg class="svg-chart" viewBox="0 0 ${w} ${h}" width="520" aria-label="數線">
    <line x1="${left}" y1="${y}" x2="${right}" y2="${y}" stroke="#334155" stroke-width="2"/>
    <path d="M ${right-9} ${y-5} L ${right} ${y} L ${right-9} ${y+5}" fill="none" stroke="#334155" stroke-width="2"/>
    ${ticks}
    <line x1="${start}" y1="${y-18}" x2="${end}" y2="${y-18}" stroke="var(--primary)" stroke-width="6" stroke-linecap="round"/>
    ${goRight?`<path d="M ${end-10} ${y-24} L ${end} ${y-18} L ${end-10} ${y-12}" fill="none" stroke="var(--primary)" stroke-width="4"/>`:`<path d="M ${start+10} ${y-24} L ${start} ${y-18} L ${start+10} ${y-12}" fill="none" stroke="var(--primary)" stroke-width="4"/>`}
    <circle cx="${x(value)}" cy="${y-18}" r="7" fill="${closed?"var(--primary)":"#fff"}" stroke="var(--primary)" stroke-width="3"/>
  </svg></div>`;
}
function barChartSVG(values,labels){
  const w=520,h=245,left=45,bottom=205,top=25,max=Math.max(...values);
  const bw=42,gap=(w-left-25-values.length*bw)/(values.length+1);
  let bars="",axis=`<line x1="${left}" y1="${top}" x2="${left}" y2="${bottom}" stroke="#334155" stroke-width="2"/><line x1="${left}" y1="${bottom}" x2="${w-20}" y2="${bottom}" stroke="#334155" stroke-width="2"/>`;
  values.forEach((v,i)=>{const x=left+gap+(bw+gap)*i,bh=(v/max)*(bottom-top-20),y=bottom-bh;bars+=`<rect x="${x}" y="${y}" width="${bw}" height="${bh}" rx="5" fill="var(--primary)" opacity=".78"/><text x="${x+bw/2}" y="${y-7}" text-anchor="middle" font-size="14" font-weight="700">${v}</text><text x="${x+bw/2}" y="${bottom+22}" text-anchor="middle" font-size="13">${labels[i]}</text>`});
  return `<div class="diagram-box"><svg class="svg-chart" viewBox="0 0 ${w} ${h}" width="520">${axis}${bars}</svg></div>`;
}
function lineChartSVG(values,labels){
  const w=520,h=245,left=45,bottom=205,top=25,max=Math.max(...values),min=Math.min(...values),span=Math.max(1,max-min);
  const x=i=>left+30+i*(w-left-80)/(values.length-1),y=v=>bottom-20-(v-min)/span*(bottom-top-45);
  const pts=values.map((v,i)=>`${x(i)},${y(v)}`).join(" ");
  let dots="";
  values.forEach((v,i)=>dots+=`<circle cx="${x(i)}" cy="${y(v)}" r="5" fill="var(--primary)"/><text x="${x(i)}" y="${y(v)-10}" text-anchor="middle" font-size="13">${v}</text><text x="${x(i)}" y="${bottom+20}" text-anchor="middle" font-size="13">${labels[i]}</text>`);
  return `<div class="diagram-box"><svg class="svg-chart" viewBox="0 0 ${w} ${h}" width="520"><line x1="${left}" y1="${top}" x2="${left}" y2="${bottom}" stroke="#334155" stroke-width="2"/><line x1="${left}" y1="${bottom}" x2="${w-20}" y2="${bottom}" stroke="#334155" stroke-width="2"/><polyline points="${pts}" fill="none" stroke="var(--primary)" stroke-width="4"/>${dots}</svg></div>`;
}
function pieChartSVG(parts,labels){
  const total=parts.reduce((a,b)=>a+b,0),cx=150,cy=130,r=95;
  let start=-Math.PI/2,paths="",legend="";
  const colors=["#60a5fa","#fb7185","#34d399","#fbbf24","#a78bfa"];
  parts.forEach((v,i)=>{const ang=v/total*Math.PI*2,end=start+ang,x1=cx+r*Math.cos(start),y1=cy+r*Math.sin(start),x2=cx+r*Math.cos(end),y2=cy+r*Math.sin(end),large=ang>Math.PI?1:0;paths+=`<path d="M ${cx} ${cy} L ${x1} ${y1} A ${r} ${r} 0 ${large} 1 ${x2} ${y2} Z" fill="${colors[i%colors.length]}" stroke="#fff" stroke-width="2"/>`;legend+=`<rect x="285" y="${50+i*30}" width="16" height="16" fill="${colors[i%colors.length]}"/><text x="309" y="${63+i*30}" font-size="14">${labels[i]} ${Math.round(v/total*100)}%</text>`;start=end});
  return `<div class="diagram-box"><svg class="svg-chart" viewBox="0 0 520 270" width="520">${paths}${legend}</svg></div>`;
}
function gridReflectionSVG(points,axisX=0){
  const w=360,h=280,ox=180,oy=140,scale=28;
  let grid="";
  for(let i=-5;i<=5;i++){grid+=`<line x1="${ox+i*scale}" y1="0" x2="${ox+i*scale}" y2="${h}" stroke="#e2e8f0"/><line x1="0" y1="${oy+i*scale}" x2="${w}" y2="${oy+i*scale}" stroke="#e2e8f0"/>`}
  const poly=points.map(p=>`${ox+p[0]*scale},${oy-p[1]*scale}`).join(" ");
  return `<div class="diagram-box"><svg class="svg-chart" viewBox="0 0 ${w} ${h}" width="360">${grid}<line x1="${ox+axisX*scale}" y1="0" x2="${ox+axisX*scale}" y2="${h}" stroke="#db2777" stroke-width="4"/><polyline points="${poly} ${points.length?poly.split(" ")[0]:""}" fill="rgba(14,165,233,.15)" stroke="#0ea5e9" stroke-width="4"/></svg></div>`;
}
function blockViewSVG(grid){
  const cell=34,w=grid[0].length*cell+20,h=grid.length*cell+20;
  let s="";
  grid.forEach((row,r)=>row.forEach((v,c)=>{if(v)s+=`<rect x="${10+c*cell}" y="${10+r*cell}" width="${cell}" height="${cell}" fill="var(--primary-light)" stroke="var(--primary-dark)" stroke-width="2"/>`}));
  return `<svg viewBox="0 0 ${w} ${h}" width="${w}" height="${h}">${s}</svg>`;
}

