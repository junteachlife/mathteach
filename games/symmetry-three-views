function g6AxisCount(){
  const items=[["正方形",4],["長方形",2],["等腰三角形",1],["等邊三角形",3],["菱形",2],["圓",999]],o=pick(items);
  const choices=o[1]===999?["1 條","2 條","4 條","無限多條"]:shuffle(["1 條","2 條","3 條","4 條"]).slice(0,4);
